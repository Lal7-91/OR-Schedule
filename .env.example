# Copy this file to .env and fill in real values. .env is gitignored.

# The OpenAI-compatible endpoint of your self-hosted Ollama server, e.g.
# http://192.168.1.42:11434/v1 (find the LAN IP on the other PC, and make
# sure Ollama was started with OLLAMA_HOST=0.0.0.0 so it's reachable).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any Ollama model you've pulled that supports tool/function calling,
# e.g. qwen2.5:7b-instruct or llama3.1:8b-instruct-q4_K_M.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Ollama ignores this, but the OpenAI-compatible client requires a
# non-empty value.
OLLAMA_API_KEY=ollama

# Safety cap on supervisor revise-loops per run.
MAX_SUPERVISOR_ITERATIONS=5

# Set to 1 to skip the real LLM entirely and run a trivial scripted model
# instead (useful to confirm the graph runs end-to-end with no network).
HARNESS_DRY_RUN=0
